# PostgreSQL (docker compose + init_db.sh)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=pguser
PG_PASSWORD=secret
PG_DB=providerdb

# Application database connection (must match PG_* above)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pguser
DB_PASSWORD=secret
DB_NAME=providerdb

# TON
MASTER_ADDRESS=UQB3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d0x0
TON_CONFIG_URL=https://ton-blockchain.github.io/global.config.json
BATCH_SIZE=100

# Server
SYSTEM_PORT=9090
SYSTEM_ADNL_PORT=16167
SYSTEM_LOG_LEVEL=0
SYSTEM_ACCESS_TOKENS=
SYSTEM_STORE_HISTORY_DAYS=90
